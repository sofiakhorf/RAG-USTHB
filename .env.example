# Environment variable template for RAG-USTHB
# Copy to `.env` at the repository root and fill in real values.
# `.env` is git-ignored — never commit real secrets.

# --- Preprocessing pipeline (mirrors config/settings.py defaults) ---
LIBREOFFICE_PATH=/usr/bin/soffice
TESSERACT_LANG_FRA=fra
TESSERACT_LANG_ARA=fra+ara
TESSDATA_PREFIX=
MAX_WORKERS=8

