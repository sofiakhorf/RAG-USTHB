# Environment variable template for RAG-USTHB
# Copy to `.env` at the repository root and fill in real values.
# `.env` is git-ignored — never commit real secrets.

# --- Preprocessing pipeline (mirrors config/settings.py defaults) ---
LIBREOFFICE_PATH=/usr/bin/soffice
TESSERACT_LANG_FRA=fra
TESSERACT_LANG_ARA=fra+ara
TESSDATA_PREFIX=
MAX_WORKERS=8

# --- Backend Django (read by backend/config/settings.py) ---
# python-dotenv loads this file from the repository root at startup.
# PLACEHOLDERS ONLY - `.env` is git-ignored; never put real credentials here.
#
# DJANGO_ENV selects the security posture:
#   development (default) -> DEBUG defaults to True; a clearly-insecure
#                            fallback SECRET_KEY is allowed (with a warning).
#                            If the DB_* block below is not fully set, Django
#                            falls back to local SQLite (backend/db.sqlite3).
#   production            -> DEBUG forced off, and SECRET_KEY, ALLOWED_HOSTS
#                            plus DB_NAME/DB_USER/DB_PASSWORD/DB_HOST are all
#                            REQUIRED; the process refuses to start without
#                            them.
# DJANGO_ENV=development
#
# Generate a real one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# SECRET_KEY=
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL connection (Supabase or self-hosted) ---
# Django needs FOUR values set together (DB_NAME, DB_USER, DB_PASSWORD,
# DB_HOST) to use PostgreSQL; otherwise it falls back to SQLite.
# DB_PORT is optional and defaults to 5432.
# settings.py already hardcodes sslmode=require, so no SSL variable is needed.
#
# HOW TO FILL THIS IN FOR SUPABASE LATER:
#   1. Supabase Dashboard -> Project Settings -> Database.
#   2. Copy the "Connection string" URI, which looks like
#        postgresql://postgres.abcdefghij:<PASSWORD>@aws-0.xx.pooler.supabase.com:6543/postgres
#   3. Split it into the variables below (everything after the scheme up to
#      the "@" is the user; the part between "@" and "/" is the host).
#   4. Use the Pooler (port 6543) for serverless/transaction mode, or the
#      direct connection (port 5432) for session mode.
#   5. `manage.py migrate` has never been run against it, so the schema must
#      be created deliberately by you when you are ready.
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=5432

# --- Supabase / PostgreSQL + pgvector — planned ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Keycloak authentication — planned ---
# KEYCLOAK_SERVER_URL=
# KEYCLOAK_REALM=
# KEYCLOAK_CLIENT_ID=
# KEYCLOAK_CLIENT_SECRET=

# --- RAG / LLM (planned) ---
# EMBEDDING_MODEL=
# LLM_API_KEY=
